// Do not fill this in by hand. Run scripts/make-secrets.sh: it writes Secrets.xcconfig (gitignored)
// from backend/.env. Then build and run from Xcode: the app seeds the values into the phone on first launch.
// The names it carries over, as the Info.plist Seed… keys and the Connections sheet read them:
ANTHROPIC_API_KEY = sk-ant-your-key-here
HEVY_API_KEY =
WHOOP_CLIENT_ID =
WHOOP_CLIENT_SECRET =
STRAVA_CLIENT_ID =
STRAVA_CLIENT_SECRET =
MERCURY_API_TOKEN =
CODEFORCES_HANDLE =
