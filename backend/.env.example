# Copy to backend/.env (gitignored) and export the variables before starting the server.
# The process reads the environment only.

# Claude API key (platform.claude.com). Leave empty to use templates.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://127.0.0.1:8787/v1/oauth/whoop/callback
WHOOP_ACCESS_TOKEN=
WHOOP_REFRESH_TOKEN=
WHOOP_EXPIRES_AT=
WHOOP_WEBHOOK_SECRET=

# Unofficial iOS/private API (backend/whoop_private). Separate from OAuth above.
# Never commit real values. Tokens also persist to backend/.secrets/whoop_private.json.
WHOOP_PRIVATE_EMAIL=
WHOOP_PRIVATE_PASSWORD=
WHOOP_PRIVATE_ACCESS_TOKEN=
WHOOP_PRIVATE_REFRESH_TOKEN=
WHOOP_INSTALLATION_ID=
WHOOP_TIMEZONE=

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://127.0.0.1:8787/v1/oauth/strava/callback
STRAVA_ACCESS_TOKEN=
STRAVA_REFRESH_TOKEN=
STRAVA_EXPIRES_AT=
STRAVA_WEBHOOK_VERIFY_TOKEN=

MERCURY_API_TOKEN=
MERCURY_API_BASE_URL=https://api.mercury.com/api/v1
MERCURY_WEBHOOK_SECRET=
MERCURY_SETTLE_HOUR=21
MERCURY_CATEGORY_MAP=
MERCURY_INCOME_COUNTERPARTY_REGEX=
# FIN level: monthly budget in USD, and an optional share of income to treat as tax (0-0.6).
MONTHLY_BUDGET_USD=
MONTHLY_TAX_RESERVE_RATE=0
# INT level: your Codeforces handle (public, no key).
CODEFORCES_HANDLE=

# Hevy Pro API key (hevy.com/settings).
HEVY_API_KEY=
